# =============================================================================
# MetaVault environment variables
#
# Copy to `.env` and fill in. In production (Railway) set these on BOTH the
# `web` and `worker` services. Vars marked "Railway provides" are injected
# automatically when you attach the Postgres/Redis plugins.
# =============================================================================

# --- Shopify app credentials (Partner Dashboard → App setup) ----------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_metaobject_definitions,write_metaobject_definitions,read_metaobjects,write_metaobjects,read_products,write_products,read_customers,write_customers,read_orders,write_orders
# Public URL of the app. In dev the Shopify CLI injects this (the tunnel URL);
# in production set it to your Railway URL, e.g. https://metavault.up.railway.app
SHOPIFY_APP_URL=
# Optional: only if the app is installed on a store with a custom domain.
# SHOP_CUSTOM_DOMAIN=

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
# Do NOT set HOST to a URL. `remix-serve` reads HOST as the interface to bind
# to, so a public hostname makes it try to bind a public IP and die with
# EADDRNOTAVAIL. Leave it unset to bind all interfaces; use SHOPIFY_APP_URL for
# the app's public URL.
# Secret used to sign local download tokens (falls back to SHOPIFY_API_SECRET).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- Database (Railway provides DATABASE_URL) --------------------------------
DATABASE_URL=postgresql://user:password@host:5432/metavault

# --- Redis / BullMQ queue (Railway provides REDIS_URL) -----------------------
# Preferred: a single connection URL. Use rediss:// for TLS.
REDIS_URL=redis://default:password@host:6379
# Fallback for local setups without a URL (ignored when REDIS_URL is set):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Cloudflare R2 storage ---------------------------------------------------
# When these are set, files (exports, backups, error reports) are stored in R2.
# If they're absent, MetaVault automatically falls back to local filesystem
# storage (LOCAL_STORAGE_DIR) — handy for local dev.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=metavault
# Optional. Endpoint is derived from R2_ACCOUNT_ID if omitted.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Optional. Set only for a PUBLIC bucket — downloads then use this base URL
# directly instead of a time-limited presigned URL.
# R2_PUBLIC_URL=https://files.example.com

# --- Email notifications (Resend) --------------------------------------------
# Job-completion emails ("your export is ready", "your backup failed"). If these
# are absent, the app logs the payload instead of sending (no dead behavior).
# RESEND_API_KEY=re_xxxxxxxx
# From address — the domain must be verified in Resend.
# RESEND_FROM=MetaVault <notifications@yourdomain.com>

# --- Support inbox -----------------------------------------------------------
# Where in-app support requests (Help & Feedback) are emailed. Unlike merchant
# job notifications, this works with Resend's sandbox sender BECAUSE the
# recipient is the Resend account owner — set it to that same address.
# Every request is also stored in the SupportRequest table regardless, so a mail
# failure can never lose one. Falls back to APP_CONTACT_EMAIL.
#
# PRIVATE: this is the routing inbox, not the address merchants are shown. The
# public contact address on the support page and the legal pages is
# APP_CONTACT_EMAIL — keep them separate so a personal inbox is never published.
# Set this on the WEB service; the worker never sends support mail.
# SUPPORT_TO_EMAIL=you@example.com

# --- Local development only ---------------------------------------------------
# Where files are written when R2 is not configured.
# LOCAL_STORAGE_DIR=/tmp/metavault-exports
# Force a plan without a real charge (dev only; ignored in production).
# SHOP_PLAN_OVERRIDE=agency
# Force Shopify billing test charges on/off (defaults to on outside production).
# SHOPIFY_BILLING_TEST=true
# Contact address shown on the hosted /privacy and /terms pages.
# APP_CONTACT_EMAIL=support@metavault.app
