generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ImportJob {
  id             String    @id @default(cuid())
  shopId         String
  type           String
  status         String    @default("pending")
  totalRows      Int       @default(0)
  successRows    Int       @default(0)
  failedRows     Int       @default(0)
  fileUrl        String?
  errorReportUrl String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([shopId])
  @@index([status])
}

model ExportJob {
  id          String    @id @default(cuid())
  shopId      String
  type        String
  status      String    @default("pending")
  fileUrl     String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([shopId])
  @@index([status])
}

model BackupJob {
  id        String    @id @default(cuid())
  shopId    String
  status    String    @default("pending")
  fileUrl   String?
  /// Size of the snapshot JSON in bytes, shown in the backup history table.
  sizeBytes Int?
  /// Metafields + metaobjects captured, used for the snapshot summary.
  itemCount Int?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([shopId])
}

/// Per-shop app state that isn't a Shopify resource: resolved billing plan
/// (mirrored from the active appSubscription) and notification preferences.
model ShopSettings {
  id                 String    @id @default(cuid())
  shopId             String    @unique
  plan               String    @default("free")
  subscriptionGid    String?
  subscriptionName   String?
  subscriptionStatus String?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  isTest             Boolean   @default(false)
  emailNotifications Boolean   @default(true)
  notifyEmail        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ActivityLog {
  id           String   @id @default(cuid())
  shopId       String
  action       String
  resourceType String
  rowCount     Int      @default(0)
  staffAccount String?
  createdAt    DateTime @default(now())

  @@index([shopId])
  @@index([createdAt])
}

/// A support request or piece of feedback sent from inside the app.
///
/// The row is the source of truth: it is committed before any email is
/// attempted, so a submission can never be lost to a mail failure. The email to
/// the app owner is a best-effort notification on top, and its outcome is
/// recorded here (`emailedAt` / `emailError`) so a silent delivery failure is
/// visible rather than invisible.
model SupportRequest {
  id      String @id @default(cuid())
  shopId  String
  /// suggestion | bug | question | billing | other
  type    String
  /// Feature area the merchant picked, for triage. Free-form, may be null.
  area    String?
  subject String
  message String
  /// Where a reply should go — prefilled from the store owner's email, editable.
  replyEmail String
  /// low | normal | blocking. Only collected for bug reports.
  urgency    String?
  /// Email on the session that submitted, when known. Not merchant-supplied.
  staffEmail String?
  /// Plan at submission time, so a report can be read in context.
  plan       String  @default("free")
  /// Opt-in technical context (shop, plan, app version, recent job outcomes).
  /// Never customer or order data.
  diagnostics Json?
  /// new | open | closed — for triage; nothing in the merchant UI writes it.
  status      String    @default("new")
  emailedAt   DateTime?
  emailError  String?
  createdAt   DateTime  @default(now())

  @@index([shopId])
  @@index([createdAt])
  @@index([status])
}

/// A deliberate, merchant-authorized link between two stores for cross-store
/// copy. `shopA` generates a one-time `code`; `shopB` redeems it, which flips
/// the link to "active". Copy is only ever permitted between an active pair, so
/// one merchant can never target another merchant's store just because both
/// happen to have the app installed.
model StoreConnection {
  id        String    @id @default(cuid())
  shopA     String
  shopB     String?
  code      String?   @unique
  status    String    @default("pending") // pending | active
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([shopA])
  @@index([shopB])
  @@index([status])
}
